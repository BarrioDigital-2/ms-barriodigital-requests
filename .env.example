# Copiar como .env en la EC2 de datos y completar. El archivo .env NO se sube a Git.

# ========== MySQL ==========
DB_ROOT_PASSWORD=cambiar-esta-clave
DB_NAME=barriodigital
DB_USERNAME=barriodigital
DB_PASSWORD=cambiar-esta-clave

# ========== Azure AD (mismos valores que el front) ==========
AZURE_TENANT_ID=92b9ffd8-4da1-4956-b85b-62654b654d25
AZURE_API_CLIENT_ID=8b0cc19f-2671-49c7-beff-816087690691

# ========== RabbitMQ (EC2 de mensajeria) ==========
# IP PRIVADA de la EC2 de mensajeria (ej. 172.31.20.15), se ve en la consola de AWS
RABBITMQ_HOST=172.31.x.x
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=barriodigital
RABBITMQ_PASSWORD=cambiar-esta-clave
